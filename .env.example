# Copy to .env and adjust for your host. .env is gitignored.

# GID of the group that owns /var/run/docker.sock on the host, so the
# container's non-root appuser can access it. Wrong value fails silently:
# container discovery just returns zero containers, no error shown.
#
# Linux: find it with `getent group docker | cut -d: -f3`
# Docker Desktop (Windows/macOS): the socket is owned by root — use 0
DOCKER_GID=105

# Host port to publish the dashboard/API on.
DOCKWATCH_PORT=10801

# Dashboard login credentials, used only to bootstrap the account on first
# run. Once a password is set (via this or `dockwatch config set-password`),
# these env vars are ignored on every subsequent start — editing .env after
# that point does nothing until credentials are reset.
DOCKWATCH_USERNAME=admin
DOCKWATCH_PASSWORD=changeme
