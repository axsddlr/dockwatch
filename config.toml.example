# dockwatch example configuration
# Copy to ~/.config/dockwatch/config.toml and customize.

pinned = [
  # "plex",
]

ignored = [
  # "db",
]

notify_only = [
  # "nginx",
]

include_tags = [
  # "^1\\.",
]

exclude_tags = [
  # "-rc$",
]

# Valid values: "new", "update"
notify_on = ["update"]
first_check_notify = false

# Scheduler
schedule_interval_seconds = 300
schedule_jitter_seconds = 30
run_on_startup = true
max_concurrent_checks = 5

# Suppress update offers until this many days have passed since dockwatch
# first observed the newer tag (0 = off). Per-container override via the
# `dockwatch.update_delay_days` label.
update_delay_days = 0

[notifications]
# Generic webhook endpoint (POST JSON payload)
webhook_url = ""

# Discord webhook URL
discord_webhook = ""

# ntfy topic URL
ntfy_url = ""

[portainer]
# Optional read-only Portainer discovery/check source
enabled = false
url = "https://portainer.local:9443"
api_key = ""

# Empty = all environments visible to the API key
environments = [
  # "1",
  # "2",
]

# Remote dockwatch agents: each agent runs on another Docker PC and exposes
# that host's containers to this instance. Generate a token with
# `openssl rand -hex 32` and start the agent with
# `dockwatch agent --token <token>` (or DOCKWATCH_AGENT_TOKEN).
[[agents]]
name = "media-pc"
url = "http://media-pc:8081"
token = ""
enabled = true

[compose_projects]
# Optional strict mappings for compose-managed container updates.
# dockwatch will only run compose updates when the discovered
# com.docker.compose.project label matches one of these entries.

[compose_projects.media]
workdir = "/srv/media"
files = ["compose.yml"]
project_name = "media"

[compose_projects.downloads]
workdir = "/srv/downloads"
files = ["compose.yml", "compose.override.yml"]
project_name = "downloads"

[trivy]
# Vulnerability scanning via Trivy (https://trivy.dev)
# The Docker Compose image bundles trivy — no separate install needed.
# For native installs: brew install trivy / apt install trivy.
enabled = false
binary_path = "trivy"

# Severity levels to report (CRITICAL, HIGH, MEDIUM, LOW, UNKNOWN)
severity = ["CRITICAL", "HIGH"]

# Scanners to run: vuln, secret, misconfig, license
scanners = ["vuln"]

# Max scan duration per image
timeout_seconds = 300

# Skip trivy DB auto-update before each scan
skip_db_update = false

# Cache scan results (minutes)
cache_ttl_minutes = 60

[health]
# Health-check watchdog: samples container health and can auto-restart
# unhealthy containers and notify on state transitions.
enabled = false

# How often to sample container health (seconds, minimum 10)
interval_seconds = 60

# Restart unhealthy containers automatically
auto_restart = false

# Auto-restart is per container, not global: a container also needs the
# `dockwatch.health.auto_restart=true` label or the "Auto-restart" checklist
# entry in Monitoring Scope. A `dockwatch.health=false` label opts a container
# out entirely and beats both.

# Only restart containers that became unhealthy (false also restarts exited)
restart_unhealthy_only = true

# Consecutive unhealthy samples before acting
unhealthy_after_samples = 2

# Max auto-restarts per container per hour (0 = unlimited)
max_restarts_per_hour = 3

# Cooldown between restarts of the same container (seconds)
cooldown_seconds = 300

# Notify on health state transitions
notify_transitions = true

[hooks]
# Per-container lifecycle hooks. Set DOCKWATCH_ENABLE_HOOKS=true in the
# backend process to enable hook execution. Create one
# [hooks."<container-name>"] section per container; each phase is a list of
# shell commands run in order. The five phases are pre_update, post_update,
# pre_stop, pre_rollback, and post_rollback. A per-phase
# `dockwatch.hook.<phase>` label wins over the config entry for that phase.
#
# For agent-managed containers hooks run ONLY on the central instance; the
# agent itself needs DOCKWATCH_AGENT_ENABLE_EXEC=true to expose exec.

[hooks."example"]
pre_update = [
  # "echo before update",
]
post_update = []
pre_stop = []
pre_rollback = []
post_rollback = []

[hook_defaults]
# Defaults applied to every container hook.
# timeout_seconds is clamped to 1-300 (the agent exec endpoint's ceiling).
timeout_seconds = 60
user = ""
workdir = ""

[prune]
# Image pruning for the local Docker daemon (and every enabled agent host).
enabled = false

# Run the prune sweep this often (hours, minimum 1)
interval_hours = 24

# Run a prune sweep on startup
run_on_startup = false

# "dangling" (untagged images only) or "unused" (all images with no container)
mode = "dangling"

# Keep this many recent images per repository (0 disables the guard)
keep_recent_per_repository = 3

# Notify after a prune sweep
notify = false

# Optional container labels can override tag filters:
# dockwatch.include_tags = "^1\\.;^2\\."
# dockwatch.exclude_tags = "-rc$"
